flowchart TD
    A[Пользователь вводит данные в форму\nили открывает страницу со списком] --> B[Фронтенд читает сырые значения]
    B --> C[Очищаем текст\nубираем пробелы по краям, лишние пробелы внутри, пустые значения]
    C --> D[Проверяем обязательные поля\nесли чего-то не хватает, показываем ошибку]
    D -->|Все поля есть| E[Приводим данные к нужному виду]
    D -->|Есть ошибка| Z[Останавливаем обработку и ждём исправления]

    E --> E1[Строки приводим к нормальному виду\nнапример, имя, логин, описание]
    E --> E2[Числа и даты переводим в правильный формат\nнапример, срок, id, дата завершения]
    E --> E3[Из одной строки ФИО выделяем имя и фамилию\nнапример, Иван Петров делим на first_name и last_name]
    E --> E4[Для файлов создаём FormData\nнапример, фото оборудования]
    E --> E5[Для обычных запросов создаём JSON]

    E1 --> F[Формируем payload для API]
    E2 --> F
    E3 --> F
    E4 --> F
    E5 --> F

    F --> G[Если запрос не безопасный\nPOST, PATCH, DELETE\nдобавляем CSRF-токен]
    G --> H[Отправляем fetch-запрос с credentials: include\nчтобы сессия пользователя сохранилась]
    H --> I{Ответ от сервера успешный?}
    I -->|Нет| J[Получаем код ошибки\nпоказываем понятное сообщение]
    I -->|Да| K{Это ответ без тела 204?}
    K -->|Да| L[Возвращаем null\nничего парсить не нужно]
    K -->|Нет| M[Преобразуем ответ из JSON]

    subgraph FE[Фронтенд: вспомогательные методы обработки]
        FE1[handleResponse\nпроверяет, что ответ успешный]
        FE2[fetchData\nоборачивает запрос в защитный блок]
        FE3[ensureCsrfToken\nберёт токен из cookie или с сервера]
        FE4[getCsrfTokenFromCookie\nищет csrftoken в document.cookie]
        FE5[После логина сбрасываем кеш CSRF\nчтобы взять свежий токен]
        FE6[При logout очищаем authToken и кеш CSRF]
        FE7[При чтении списков принимаем и массив, и формат results]
    end

    M --> N[Фронтенд отдаёт данные в экран\nили в состояние приложения]
    L --> N

    N --> O{Какой это сценарий?}
    O -->|Вход в систему| P[Отправляем username и password\nbackend/auth/login/]
    O -->|Пользователи| Q[Создаём или обновляем пользователя]
    O -->|Подразделения| R[Создаём подразделение]
    O -->|Оборудование| S[Добавляем оборудование и фото]
    O -->|Задачи| T[Создаём задачу и комментарии]
    O -->|Инциденты| U[Регистрируем инцидент]
    O -->|Сообщения| V[Отправляем сообщение]

    P --> W[Сервер аутентифицирует пользователя]
    W --> X[login_view создаёт сессию Django]
    X --> Y[Сервер возвращает объект пользователя]
    Y --> AA[Фронтенд сохраняет пользователя\nи при наличии token кладёт его в localStorage]

    Q --> AB[addUser или updateUser\nразделяем name на first_name и last_name]
    AB --> AC[Фронтенд формирует username\nдобавляет суффикс времени, чтобы снизить риск совпадений]
    AC --> AD[UserViewSet создаёт User и профиль]
    AD --> AE[_sync_profile сохраняет роль и подразделение]
    AE --> AF[UserSerializer отдаёт готовый объект\nс name, role и departmentId]

    R --> AG[DepartmentViewSet принимает JSON]
    AG --> AH[Сериализатор проверяет поля и сохраняет запись]
    AH --> AI[Фронтенд получает новый объект подразделения]

    S --> AJ[addEquipment собирает FormData\nимя, дата, статус, подразделение, фото]
    AJ --> AK[EquipmentViewSet принимает JSON или multipart]
    AK --> AL[Сериализатор связывает оборудование с подразделением]
    AL --> AM[Если пришёл инцидент по оборудованию\nстатус может измениться на BROKEN]

    T --> AN[TaskSerializer принимает assignee_id и creator_id]
    AN --> AO[TaskViewSet сохраняет задачу]
    AO --> AP[add_comment добавляет комментарий к задаче]
    AP --> AQ[Комментарии сразу подгружаются внутри задачи]

    U --> AR[IncidentSerializer принимает reporter_id и equipment_id]
    AR --> AS[IncidentViewSet создаёт инцидент]
    AS --> AT[perform_create переводит оборудование в BROKEN\nесли инцидент не закрыт]
    AT --> AU[resolve меняет статус на RESOLVED]
    AU --> AV[Если открытых инцидентов больше нет\nоборудование возвращается в OPERATIONAL]

    V --> AW[MessageSerializer принимает sender_id и receiver_id]
    AW --> AX[MessageViewSet сохраняет сообщение]
    AX --> AY[received фильтрует сообщения по receiver=request.user]
    AX --> AZ[sent фильтрует сообщения по sender=request.user]
    AX --> BA[mark_as_read помечает выбранные сообщения как прочитанные]

    subgraph BE[Бекенд: общая методика обработки данных]
        BE1[Сериализация\nпреобразуем Django-объекты в JSON и обратно]
        BE2[Валидация\nпроверяем обязательные поля, типы и связи]
        BE3[Нормализация\nприводим поля к единому виду\nнапример, department_id и departmentId]
        BE4[Связи между сущностями\nпользователь, профиль, подразделение, оборудование, задача, комментарий, инцидент, сообщение]
        BE5[Обновление статусов\nнапример, BROKEN, OPERATIONAL, RESOLVED]
        BE6[Фильтрация по текущему пользователю\nдля входящих и исходящих сообщений]
    end

    BA --> BB[Сервер возвращает JSON]
    AF --> BB
    AI --> BB
    AM --> BB
    AQ --> BB
    AV --> BB
    BA --> BB
    BB --> BC[Фронтенд читает JSON-ответ]
    BC --> BD[Данные попадают в таблицы, карточки, списки и счётчики]

    BD --> CA[Если нужно показать список\nберём results или весь data]
    CA --> CB[Если данных нет\nпоказываем пустое состояние]
    CA --> CC[Если данные есть\nрисуем интерфейс и метрики]

    CB --> CD[Пользователь видит, что список пуст\nи может создать новую запись]
    CC --> CE[Пользователь видит обновлённые данные\nи продолжает работу]

    style Z fill:#ffe4e4,stroke:#cc6666,color:#5a1a1a
    style I fill:#fff5cc,stroke:#d6b656,color:#5a4800
    style BE1 fill:#e8f4ff,stroke:#6aa5d8,color:#12324a
    style BE2 fill:#e8f4ff,stroke:#6aa5d8,color:#12324a
    style BE3 fill:#e8f4ff,stroke:#6aa5d8,color:#12324a
    style BE4 fill:#e8f4ff,stroke:#6aa5d8,color:#12324a
    style BE5 fill:#e8f4ff,stroke:#6aa5d8,color:#12324a
    style BE6 fill:#e8f4ff,stroke:#6aa5d8,color:#12324a
